// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  email          String   @unique
  hashedPassword String
  name           String?
  role           Role     @default(USER)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  experiments ChaosExperiment[]
}

model ChaosExperiment {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  type       ExperimentType
  durationMs Int
  status     ExperimentStatus @default(PENDING)
  startedAt  DateTime?
  endedAt    DateTime?
  stoppedBy  String?          // userId of whoever called /stop — null if auto-completed
  createdBy  String           @db.ObjectId
  creator    User             @relation(fields: [createdBy], references: [id])
  createdAt  DateTime         @default(now())
  incident   Incident?

  @@index([status])
}

model Incident {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  severity        Severity         @default(MEDIUM)
  status          IncidentStatus   @default(OPEN)
  notes           String?
  alertName       String?
  fingerprint     String?          @unique
  source          IncidentSource   @default(CHAOS)
  experimentId    String?          @unique @db.ObjectId
  experiment      ChaosExperiment? @relation(fields: [experimentId], references: [id])
  aiAnalysis      AiAnalysis?
  selfHealingRuns SelfHealingRun[]
  postmortem      Postmortem?
  resolvedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status])
}

model AiAnalysis {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  incidentId       String   @unique @db.ObjectId
  incident         Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  rootCause        String
  impact           String
  remediationSteps String   // JSON-encoded string[]
  riskScore        Severity
  confidence       Int      // 0–100
  model            String   // e.g. "gpt-4o" or "mock"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
  OPERATOR
}

enum ExperimentType {
  HIGH_CPU
  HIGH_LATENCY
  SERVICE_ERROR
  DB_SLOWDOWN
  MEMORY_PRESSURE
}

enum ExperimentStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  STOPPED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

enum IncidentSource {
  CHAOS  // created by a chaos experiment
  ALERT  // created by Alertmanager webhook
}

model SelfHealingPolicy {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  alertName       String           @unique // e.g. "ChaosExperimentActive", "BackendDown"
  actionType      RemediationType
  isEnabled       Boolean          @default(true)
  cooldownSec     Int              @default(60)
  lastTriggeredAt DateTime?
  runs            SelfHealingRun[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model SelfHealingRun {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  policyId    String            @db.ObjectId
  policy      SelfHealingPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  incidentId  String?           @db.ObjectId
  incident    Incident?         @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  status      RunStatus         @default(PENDING)
  logs        String            // Log output text of actions taken
  createdAt   DateTime          @default(now())
  completedAt DateTime?
}

enum RemediationType {
  STOP_CHAOS_EXPERIMENT
  CLEAR_REDIS_FLAGS
  RESTART_CONTAINER
  SCALE_SERVICE
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model Postmortem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  incidentId String   @unique @db.ObjectId
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  content    String   // Markdown document
  status     String   @default("DRAFT") // DRAFT | APPROVED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum AnomalyStatus {
  NORMAL
  WARNING
  ANOMALY_DETECTED
  BREACH_IMMINENT
}

model AnomalyPrediction {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  metricName      String        // e.g. "CPU_USAGE", "MEMORY_PRESSURE", "LATENCY_P99", "ERROR_RATE"
  service         String        // e.g. "backend-api", "redis-cache", "mongodb-db"
  currentValue    Float
  predictedValue  Float
  burnRatePerMin  Float
  timeToBreachMin Int?          // Estimated minutes until SLA threshold breach
  confidence      Int           // 0-100
  status          AnomalyStatus @default(NORMAL)
  severity        Severity      @default(LOW)
  recommendation  String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([service])
}

// ── Level 8: Cost & Resource Optimization ────────────────────────────────────

enum OptimizationStatus {
  OPTIMAL
  UNDERUTILIZED
  OVERPROVISIONED
  WASTEFUL
}

model ResourceCostRecord {
  id                 String             @id @default(auto()) @map("_id") @db.ObjectId
  service            String             // e.g. "backend-api", "redis-cache"
  cpuCores           Float              // Allocated CPU cores
  cpuUsagePct        Float              // Actual usage %
  memoryGb           Float              // Allocated memory GB
  memoryUsagePct     Float              // Actual usage %
  hourlyCostUsd      Float              // Computed $/hr for allocated resources
  wasteUsd           Float              // Idle/unused allocation cost
  optimizationStatus OptimizationStatus @default(OPTIMAL)
  timestamp          DateTime           @default(now())

  @@index([service])
  @@index([optimizationStatus])
}

model CostOptimizationReport {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  totalMonthlyCostUsd  Float
  projectedSavingsUsd  Float
  savingsPct           Float
  recommendations      String   // JSON: { service, action, estimatedSavingUsd, priority }[]
  model                String   // "gpt-4o" or "mock"
  createdAt            DateTime @default(now())
}

// ── Level 9: Security & Compliance Auditor ───────────────────────────────────

enum ComplianceStatus {
  PASSED
  WARNING
  FAILED
  CRITICAL
}

model SecurityScanRecord {
  id                    String           @id @default(auto()) @map("_id") @db.ObjectId
  target                String           // e.g. "backend-api", "frontend-nginx", "redis-cache"
  cveCountCritical      Int
  cveCountHigh          Int
  cveCountMedium        Int
  cveCountLow           Int
  cisScore              Float            // 0 - 100
  status                ComplianceStatus @default(PASSED)
  vulnerabilities       String           // JSON: { cveId, package, installedVersion, fixedVersion, severity, description }[]
  cisChecks             String           // JSON: { checkId, title, category, status, remediation }[]
  createdAt             DateTime         @default(now())

  @@index([target])
  @@index([status])
}

model SecurityAuditReport {
  id                     String           @id @default(auto()) @map("_id") @db.ObjectId
  overallScore           Float            // 0 - 100
  totalVulnerabilities   Int
  criticalVulnerabilities Int
  complianceStatus       ComplianceStatus @default(PASSED)
  summary                String           // Markdown AI security roadmap
  model                  String           // "gpt-4o" or "mock"
  createdAt              DateTime         @default(now())
}

// ── Level 11: Automated Rollback & CI/CD Pipeline ────────────────────────────

enum DeploymentStatus {
  PENDING
  DEPLOYING
  CANARY_TESTING
  HEALTHY
  DEGRADED
  ROLLED_BACK
  FAILED
}

model DeploymentRecord {
  id              String                 @id @default(auto()) @map("_id") @db.ObjectId
  service         String                 // e.g. "backend-api", "frontend-nginx"
  version         String                 // e.g. "v2.5.0"
  previousVersion String                 // e.g. "v2.4.0" (rollback target)
  gitCommit       String                 // e.g. "c89a8e2"
  deployedBy      String                 // username or "CI/CD System"
  status          DeploymentStatus       @default(CANARY_TESTING)
  canaryErrorRate Float                  @default(0.0) // %
  canaryLatencyP99 Float                 @default(45.0) // ms
  rollbackReason  String?                // explanation if auto-rolled back
  healthChecks    DeploymentHealthCheck[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([service])
  @@index([status])
}

model DeploymentHealthCheck {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  deploymentId String           @db.ObjectId
  deployment   DeploymentRecord @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  checkName    String           // e.g. "HTTP_CANARY_PROBE", "P99_LATENCY_SLO"
  status       String           // "PASSED" | "FAILED"
  message      String
  timestamp    DateTime         @default(now())
}

// ── Level 12: Multi-Agent AI Collaboration Mesh ───────────────────────────────

enum AgentRole {
  SRE_AGENT
  FINOPS_AGENT
  SECOPS_AGENT
  CHAOS_AGENT
}

enum AgentStatus {
  IDLE
  ANALYZING
  PROPOSING_ACTION
  EXECUTING
  CONSENSUS_REACHED
}

model MultiAgentSession {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  topic            String      // Deliberation topic e.g. "System Recovery & Cost Optimization"
  incidentId       String?     @db.ObjectId
  consensusReached Boolean     @default(false)
  finalDecision    String?     // Agreed multi-domain action plan (markdown)
  messages         String      // JSON: AgentMessage[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([consensusReached])
}

model AgentTelemetry {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  agentRole     AgentRole   @unique
  status        AgentStatus @default(IDLE)
  healthScore   Float       @default(100.0)
  insightsCount Int         @default(0)
  lastActiveAt  DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// ── Level 13: AI Learning Engine ─────────────────────────────────────────────

model ResolutionFeedback {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  incidentId           String   @db.ObjectId
  resolvedBy           String   // engineer username or email
  ttmMins              Int      // time-to-mitigate in minutes
  whatWorked           String   // free-text: what remediation steps worked
  whatFailed           String?  // free-text: what was tried but failed
  suggestedImprovements String? // free-text: process improvement ideas
  rating               Int      // 1–5 star usefulness rating
  learningExtracted    Boolean  @default(false)
  createdAt            DateTime @default(now())

  @@index([incidentId])
}

model IncidentLearning {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  incidentId        String   @db.ObjectId
  incidentTitle     String
  rootCausePattern  String   // e.g. "MEMORY_LEAK_UNDER_LOAD", "DB_CONNECTION_EXHAUSTION"
  resolutionPattern String   // e.g. "SCALE_HORIZONTAL + CIRCUIT_BREAKER"
  summary           String   // AI-generated learning summary (markdown)
  keywords          String   // JSON: string[] — searchable tags
  confidenceScore   Float    // 0.0–1.0
  usefulnessVotes   Int      @default(0)
  severity          String   // Incident severity when learning was captured
  ttmMins           Int?     // time-to-mitigate for context
  model             String   // "gpt-4o" or "mock"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([rootCausePattern])
  @@index([confidenceScore])
}

// ── Level 15: Enterprise Platform Features ───────────────────────────────────

model AuditLog {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String?
  userEmail      String   @default("system")
  action         String   // e.g. "CHAOS_START", "SELF_HEALING_TOGGLE", "USER_PROMOTE", "DEPLOYMENT_ROLLBACK"
  resourceTarget String   // e.g. "HIGH_CPU", "ChaosExperimentActive", "operator@aegis.ai"
  details        String?  // JSON-encoded extra context
  ipAddress      String?  @default("127.0.0.1")
  createdAt      DateTime @default(now())

  @@index([action])
  @@index([userEmail])
}

model SystemConfig {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  clusterName             String   @default("Aegis-Prod-Cluster-01")
  environment             String   @default("PRODUCTION") // PRODUCTION | STAGING | DR
  retentionDays           Int      @default(90)
  slackWebhookUrl         String?  @default("https://hooks.slack.com/services/mock/aegis/alerts")
  pagerDutyIntegrationKey String?  @default("pd_live_aegis_key_9981")
  autoRemediationEnabled  Boolean  @default(true)
  maxChaosDurationSec     Int      @default(300)
  updatedBy               String   @default("admin@aegis.ai")
  updatedAt               DateTime @updatedAt
}

